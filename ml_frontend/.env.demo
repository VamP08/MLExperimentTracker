# Loaded by `vite build --mode demo`, which is what `npm run build:demo` runs.
#
# This file exists so the demo flag can be set without a shell-specific `VITE_DEMO=1 vite
# build` prefix, which is a syntax error in cmd.exe and would make the demo build a
# Linux-only affair. `--mode demo` works identically on every platform and needs no extra
# dependency.
#
# It is committed on purpose: it is a build switch, not a secret. `npm run build` does not
# read it, so the normal bundle is unchanged by anything here.
VITE_DEMO=1
