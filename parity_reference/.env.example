# Example environment variables for ML Tracker backend
# Copy this file to `.env` and adjust values as needed.

# Path to the experiments root directory
# Default: %USERPROFILE%\.experiment_tracker on Windows, $HOME/.experiment_tracker elsewhere
# EXPERIMENT_STORAGE_PATH=C:\Users\you\.experiment_tracker

# Server port
PORT=5000

# Bind address. Loopback by default: there is no authentication layer, so do not
# expose this on a network interface without adding one first.
HOST=127.0.0.1

# Use 'production' to enable serving the frontend build from the backend
NODE_ENV=development
